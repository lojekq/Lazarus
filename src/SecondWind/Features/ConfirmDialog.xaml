<ui:FluentWindow x:Class="SecondWind.Features.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:SecondWind.Shell"
                 Title="{x:Static l:AppInfo.Title}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{x:Static l:AppInfo.Title}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Margin="24,4,24,20">
            <ui:TextBlock FontTypography="Subtitle" Text="{l:T Confirm.Title}" Margin="0,0,0,12" />

            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="{l:T Confirm.Program}" />
            <ui:TextBlock x:Name="ExeText" TextWrapping="Wrap" Margin="0,2,0,10" />

            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="{l:T Confirm.Command}" />
            <ui:TextBox x:Name="CommandBox" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left" MaxHeight="140" Margin="0,4,0,10"
                        FontFamily="Cascadia Mono, Consolas" ClearButtonEnabled="False" VerticalScrollBarVisibility="Auto" />

            <StackPanel x:Name="FolderPanel">
                <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="{l:T Confirm.Folder}" />
                <ui:TextBlock x:Name="FolderText" TextWrapping="Wrap" Margin="0,2,0,10" />
            </StackPanel>

            <ui:TextBlock FontTypography="Caption" Appearance="Secondary" Text="{l:T Confirm.Why}" />
            <ui:TextBlock x:Name="WhyText" TextWrapping="Wrap" Margin="0,2,0,12" />

            <CheckBox x:Name="TrustBox" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="RunButton" Appearance="Primary" Content="{l:T Confirm.Run}" MinWidth="120" IsDefault="True" />
                <ui:Button x:Name="CancelButton" Content="{l:T Confirm.Cancel}" MinWidth="120" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
