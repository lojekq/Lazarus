<UserControl x:Class="Lazarus.Features.SettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Lazarus.Shell">
    <StackPanel>
        <ui:CardControl Header="{l:T Set.Hotkey}" Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,4">
            <l:HotkeyBox x:Name="HotkeyBox" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon FolderArrowUp24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Context}" />
                    <ui:TextBlock Text="{l:T Set.Context.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ContextSwitch" />
        </ui:CardControl>

        <ui:CardExpander Icon="{ui:SymbolIcon History24}" Header="{l:T Set.Journal}" Margin="0,0,0,4">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="{l:T Set.Size}" VerticalAlignment="Center" />
                    <ui:NumberBox x:Name="SizeBox" Grid.Column="1" Minimum="10" Maximum="100" SmallChange="5" MaxDecimalPlaces="0" Width="160" ClearButtonEnabled="False" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Text="{l:T Set.Days}" VerticalAlignment="Center" />
                    <ui:NumberBox x:Name="DaysBox" Grid.Column="1" Minimum="1" Maximum="30" SmallChange="1" MaxDecimalPlaces="0" Width="160" ClearButtonEnabled="False" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ui:TextBlock Text="{l:T Set.Persist}" />
                        <ui:TextBlock Text="{l:T Set.Persist.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="PersistSwitch" Grid.Column="1" />
                </Grid>
                <ui:Button x:Name="ClearButton" Content="{l:T Set.Clear}" Icon="{ui:SymbolIcon Delete20}" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,0,4">
            <ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Exclusions}" />
                    <ui:TextBlock Text="{l:T Set.Exclusions.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <ItemsControl x:Name="ExclusionList" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="ExclusionBox" PlaceholderText="obs64.exe" />
                    <ui:Button x:Name="AddButton" Grid.Column="1" Content="{l:T Set.Add}" Margin="8,0,0,0" />
                    <ui:Button x:Name="FromWindowsButton" Grid.Column="2" Content="{l:T Set.AddFromWindows}" Icon="{ui:SymbolIcon Window24}" Margin="8,0,0,0">
                        <ui:Button.ContextMenu>
                            <ContextMenu x:Name="WindowsMenu" />
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Icon="{ui:SymbolIcon ShieldCheckmark24}" Header="{l:T Set.Trusted}" Margin="0,0,0,4">
            <StackPanel>
                <ItemsControl x:Name="TrustedList" />
                <ui:TextBlock x:Name="TrustedEmpty" Text="{l:T Set.Trusted.Empty}" Appearance="Secondary" TextWrapping="Wrap" />
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Icon="{ui:SymbolIcon WindowConsole20}" IsExpanded="True" Margin="0,0,0,4">
            <ui:CardExpander.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Set.Pwsh}" />
                    <ui:TextBlock x:Name="PwshStatus" FontTypography="Caption" Appearance="Secondary" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="HookBox" IsReadOnly="True" TextWrapping="Wrap" TextAlignment="Left" FontFamily="Cascadia Mono, Consolas" FontSize="12" ClearButtonEnabled="False" />
                    <ui:Button x:Name="CopyButton" Grid.Column="1" Content="{l:T Set.Copy}" Icon="{ui:SymbolIcon Copy20}" Margin="8,0,0,0" VerticalAlignment="Top" />
                </Grid>
                <ui:TextBlock Text="{l:T Set.Pwsh.Note}" FontTypography="Caption" Appearance="Secondary" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</UserControl>
